# Never commit real keys. Copy this file to .env locally.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Qwen Model Studio endpoints are region/API-key specific.
# Example China (Beijing) shared endpoint:
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=

# Freeze one Llama hosting provider/checkpoint before the pilot.
LLAMA_PROVIDER_API_KEY=
LLAMA_BASE_URL=
LLAMA_PROVIDER_NAME=

# Local open-weight transparency track. These are NOT secrets.
# Before the local pilot, replace the blank values with exact Hugging Face
# commit/revision identifiers recorded in configs/local_models.yaml/provenance.
QWEN25_LOCAL_REVISION=
PHI35_LOCAL_REVISION=
FAIREVAL_LOCAL_DTYPE=bfloat16

# CUDA is required for the canonical local experiment. Set this to 1 only for
# tiny CI/development smoke tests where slow CPU execution is intentionally used.
FAIREVAL_ALLOW_LOCAL_CPU=0
