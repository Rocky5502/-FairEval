# Never commit real keys. Copy this file to .env locally.

# ---------------------------------------------------------------------------
# Preferred ECIR 2027 hosted path: Zhizengzeng unified OpenAI-compatible gateway
# ---------------------------------------------------------------------------
FAIREVAL_HOSTED_GATEWAY=zhizengzeng
ZZZ_BASE_URL=https://api.zhizengzeng.com/v1
ZZZ_API_KEY=

# Hosted budget policy is frozen in configs/hosted_budget.yaml.
# Default execution target/hard cap: 200 RMB / 250 RMB.

# ---------------------------------------------------------------------------
# Optional native-provider credentials retained only for separate replication.
# They are NOT required for the current gateway-only hosted phase.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
LLAMA_PROVIDER_API_KEY=
LLAMA_BASE_URL=
LLAMA_PROVIDER_NAME=

# ---------------------------------------------------------------------------
# Local open-weight transparency track (optional; not required for hosted-only)
# ---------------------------------------------------------------------------
QWEN25_LOCAL_REVISION=
PHI35_LOCAL_REVISION=
FAIREVAL_LOCAL_DTYPE=bfloat16
FAIREVAL_ALLOW_LOCAL_CPU=0
