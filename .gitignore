# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Secrets
.env
*.key

# Third-party/raw/generated/frozen data are provenance inputs, not source code.
# Exact hashes/manifests are recorded by the experiment pipeline instead.
data/raw/
data/processed/
data/generated/
data/frozen/
data/frozen-smoke/

# Local/CI execution products. Paper-facing generated artifacts under
# paper/generated/ are intentionally NOT ignored so audited final results can be
# committed deliberately when the experiment is complete.
results/*
!results/.gitkeep
dist/
artifacts/

# Paper build products
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.pdf

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
